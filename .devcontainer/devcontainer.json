{
  "name": "Test Automation for Agile Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "disableIp6tables": true },
    "ghcr.io/devcontainers/features/desktop-lite:1": { "password": "curso", "webPort": "6080" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 6080, 9323],
  "portsAttributes": {
    "3000": { "label": "Aplicación bajo prueba" },
    "6080": { "label": "Escritorio (noVNC)" },
    "9323": { "label": "Reporte de Playwright" }
  },
  "postCreateCommand": "bash scripts/instalar-entorno.sh",
  "postStartCommand": "bash scripts/red-docker-codespace.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "vitest.explorer",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ],
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
